generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model System {
  id Int @id @default(autoincrement())
  title String
  image String?
  link String

  @@map("systems")
}

model Software {
  id Int @id @default(autoincrement())
  title String
  image String?
  fileName String

  @@map("softwares")
}