generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model System {
  id Int @id @default(autoincrement())
  title String
  image String?
  link String

  @@map("systems")
}

model Software {
  id Int @id @default(autoincrement())
  title String
  image String?
  fileName String

  @@map("softwares")
}

model Application {
  id Int @id @default(autoincrement())
  title String
  fileName String

  @@map("applications")
}

model Contact {
  id Int @id @default(autoincrement())
  title String
  emails String[]
  phones String[]

  @@map("contacts")
}